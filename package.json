{
  "name": "ts-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run check:placeholders && next build",
    "start": "next start",
    "lint": "eslint .",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check-types": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --conditions=react-server --import tsx src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "check": "npm run check:placeholders && npm run format:check && npm run lint && npm run check-types && npm run test:unit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "postgres": "3.4.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^18.0.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.6",
    "pino-pretty": "^13.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.1.18",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
