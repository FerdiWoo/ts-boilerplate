import { index, pgTable, text, timestamp, uuid } from 'drizzle-orm/pg-core';

import { table1 } from '../schema/table1';

// Replace every table2/entity2 placeholder before moving this file into schema/.
const table2 = pgTable(
  'table2',
  {
    id: uuid('table2_id').primaryKey().defaultRandom(),
    table1Id: uuid('table1_id')
      .notNull()
      .references(() => table1.id, { onDelete: 'cascade' }),
    label: text('label').notNull(),
    createdAt: timestamp('created_at', { withTimezone: true })
      .defaultNow()
      .notNull(),
    updatedAt: timestamp('updated_at', { withTimezone: true })
      .defaultNow()
      .notNull(),
  },
  (table) => [index('table2_table1_id_idx').on(table.table1Id)]
);

export { table2 };

