NODE_ENV="development"

# Use the pooled connection string from Neon.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require"

# Optional. Defaults to debug in development, silent in tests, and info in production.
LOG_LEVEL="debug"

# Dedicated database used only by integration tests.
TEST_DB_URL="postgresql://user:password@localhost:5432/ts_boilerplate_test"

